{
  "name": "dsh-claude-code-provider",
  "version": "0.0.1",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@anthropic-ai/sdk": ">=0.93.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-permission-presets": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.1",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  },
  "description": "Claude Code (the official, unmodified binary, via the Agent SDK) as a model provider and subagent inside DeepSeek Harness",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "claude-code",
    "claude-agent-sdk"
  ],
  "author": "Jonathan Kelsey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jk89/dsh-claude-code-provider.git"
  },
  "homepage": "https://github.com/jk89/dsh-claude-code-provider#readme",
  "bugs": {
    "url": "https://github.com/jk89/dsh-claude-code-provider/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "patches/",
    "scripts/apply-patches.sh"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
